---
/**
 * HeroV2: editorial hero with a JS-driven verb rotator.
 */

const verbs = ['wiz', 'evolve', 'build', 'flourish', 'brainstorm', 'grow', 'riff', 'transform', 'vibe', 'bloom', 'groove', 'elevate', 'prototype', 'progress', 'design', 'emerge', 'ship', 'amplify', 'innovate', 'unlock', 'strategize', 'accelerate', 'experiment', 'empower', 'sketch', 'enable', 'create', 'rise', 'collaborate', 'mature', 'delegate', 'ascend', 'iterate', 'transcend', 'teach', 'solve', 'plan', 'code', 'reason'];
---

<section class="hero-v2 section-cream" aria-labelledby="hero-v2-heading">
  <div class="hero-v2-inner container">
    <p class="hero-v2-eyebrow">
      <span>Senior Software Engineer</span>
      <span class="eyebrow-dot" aria-hidden="true">·</span>
      <span>AI Enablement Engineer</span>
    </p>
    <h1 id="hero-v2-heading" class="hero-v2-display">
      <span class="line">I help humans</span>
      <span class="line">
        <span
          class="verb-rotator"
          data-verbs={JSON.stringify(verbs)}
          aria-label={`${verbs.join(', ')} with AI`}
        >
          <span class="verb-current" aria-hidden="true">{verbs[0]}</span>
        </span>
      </span>
      <span class="line"><span class="with-ai">with AI.</span></span>
    </h1>

    <div class="hero-v2-subhead">
      <p class="subhead-lead">
        No human left behind.
      </p>
      <p class="subhead-body">
        As an AI Enablement Engineer, I coach engineering teams on how
        to build with AI effectively and responsibly, while shaping the
        direction of engineering culture at scale. This mission is at the
        center of the job: building a future where technology, ethics,
        and humanity move forward together, with no human left behind.
      </p>
    </div>

  </div>
</section>

<script>
  const rotator = document.querySelector<HTMLElement>('.verb-rotator');
  const current = rotator?.querySelector<HTMLElement>('.verb-current');
  const verbs: string[] = JSON.parse(rotator?.dataset.verbs ?? '[]');

  if (
    rotator &&
    current &&
    verbs.length > 0 &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const TYPE_MS = 90;
    const DELETE_MS = 45;
    const HOLD_MS = 1500;
    const SETTLE_MS = 350;

    // Always lead with "wiz", then shuffle the rest. Reshuffle each full loop
    // so the order stays fresh on long sessions.
    const [first, ...rest] = verbs;
    const shuffle = (arr: string[]) => {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
    };
    shuffle(rest);
    let ordered = [first, ...rest];
    let index = 0;
    current.textContent = '';

    const type = (verb: string, i: number, done: () => void) => {
      if (i > verb.length) {
        window.setTimeout(done, HOLD_MS);
        return;
      }
      current.textContent = verb.slice(0, i);
      window.setTimeout(() => type(verb, i + 1, done), TYPE_MS);
    };

    const erase = (done: () => void) => {
      const text = current.textContent ?? '';
      if (text.length === 0) {
        window.setTimeout(done, SETTLE_MS);
        return;
      }
      current.textContent = text.slice(0, -1);
      window.setTimeout(() => erase(done), DELETE_MS);
    };

    const next = () => {
      const verb = ordered[index];
      type(verb, 0, () => {
        erase(() => {
          index = (index + 1) % ordered.length;
          if (index === 0) {
            shuffle(rest);
            ordered = [first, ...rest];
          }
          next();
        });
      });
    };

    next();
  }
</script>

<style>
  .hero-v2 {
    display: flex;
    flex-direction: column;
    padding-block: var(--space-lg) var(--space-md);
  }

  .hero-v2-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    width: 100%;
  }

  .hero-v2-eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-code);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-2xs);
  }

  .eyebrow-dot {
    color: var(--color-text-muted);
  }

  .hero-v2-display {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 144, "SOFT" 0, "wght" 800;
    font-size: clamp(3rem, 1rem + 9vw, 9rem);
    font-weight: 800;
    line-height: 1.0;
    letter-spacing: -0.04em;
    color: var(--color-text);
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .hero-v2-display .line {
    display: block;
  }

  .verb-rotator {
    display: inline-block;
    vertical-align: baseline;
    white-space: nowrap;
    min-height: 1em;
    line-height: 1;
  }

  .verb-current {
    display: inline-block;
    font-family: "Playfair Display", serif;
    font-style: italic;
    font-weight: 600;
    font-variation-settings: normal;
    color: var(--color-cobalt);
    letter-spacing: -0.05em;
  }

  .verb-current::after {
    content: "|";
    display: inline-block;
    margin-left: 0.05em;
    color: var(--color-cobalt);
    font-style: normal;
    font-weight: 400;
    animation: verb-caret-blink 1s steps(2) infinite;
  }

  @keyframes verb-caret-blink {
    50% { opacity: 0; }
  }

  .hero-v2-subhead {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    max-width: 42rem;
    margin-top: var(--space-md);
  }

  .subhead-lead {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
  }

  .subhead-body {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }


  .hero-v2-meta {
    font-family: var(--font-code);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-lime-dark);
    display: flex;
    gap: var(--space-xs);
    align-items: center;
    margin-top: var(--space-xl);
  }

  .meta-dot {
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .hero-v2 {
      padding-block: var(--space-md) var(--space-xl);
    }

    .hero-v2-display {
      font-size: clamp(2.25rem, 7vw + 1rem, 4rem);
    }

  }
</style>
