---
import { mainNav } from '../../data/navigation';

const currentPath = Astro.url.pathname;
---

<header class="site-header" role="banner">
  <div class="site-nav container" aria-label="Main navigation">
    <a href="/" class="site-mark" aria-label="wizwit home">
      <img
        src="/images/logo-final.png"
        alt=""
        class="site-mark-logo"
        width="40"
        height="28"
        loading="eager"
      />
      <span class="site-mark-brand">WIZWIT</span>
    </a>

    <button
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Open menu"
    >
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
      <span class="nav-toggle-bar" aria-hidden="true"></span>
    </button>

    <nav id="nav-menu" class="nav-list" role="navigation" aria-label="Main">
      <ul role="list" class="nav-items">
        {mainNav.map(({ label, href }) => {
          const isActive = currentPath === href || (href !== '/' && href !== '/#work' && currentPath.startsWith(href));
          return (
            <li>
              <a
                href={href}
                class:list={['nav-link', { active: isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                {label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background-color: var(--color-cream);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-base),
                background-color var(--duration-base);
  }

  .site-header.scrolled {
    border-bottom-color: var(--color-gray-border);
    background-color: rgba(245, 243, 238, 0.95);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .site-header.menu-open {
    z-index: 9999;
    position: fixed;
    inset: 0;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background-color: var(--color-cream);
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.5rem;
    gap: var(--space-md);
  }

  .site-mark {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    text-decoration: none;
    color: var(--color-text);
    transition: opacity var(--duration-fast);
  }

  .site-mark:hover {
    opacity: 0.8;
  }

  .site-mark-logo {
    width: 40px;
    height: auto;
    transform: rotate(-12deg);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .site-mark:hover .site-mark-logo {
    transform: rotate(-2deg) scale(1.05);
  }

  .site-mark-brand {
    font-family: var(--font-code);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--color-text);
    line-height: 1;
  }

  .nav-items {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-link {
    font-family: var(--font-code);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: var(--space-3xs) 0;
    position: relative;
    transition: color var(--duration-fast);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-cobalt);
    transition: width var(--duration-base) var(--ease-out);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-cobalt);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  /* ---- Mobile Nav Toggle ---- */

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    padding: 4px;
    background: none;
    border: none;
    cursor: pointer;
    position: relative;
    z-index: 10001;
  }

  .nav-toggle-bar {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--color-text);
    border-radius: 1px;
    transition: transform var(--duration-base) var(--ease-out),
                opacity var(--duration-fast);
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ---- Responsive ---- */

  @media (max-width: 768px) {
    .nav-toggle {
      display: flex;
    }

    .nav-list {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: var(--color-cream);
      opacity: 0;
      visibility: hidden;
      transition: opacity var(--duration-base) var(--ease-out),
                  visibility var(--duration-base);
      z-index: 10000;
    }

    .nav-list.open {
      opacity: 1;
      visibility: visible;
    }

    .nav-items {
      flex-direction: column;
      gap: var(--space-lg);
    }

    .nav-link {
      font-family: var(--font-heading);
      font-size: var(--text-2xl);
      text-transform: none;
      letter-spacing: -0.01em;
      font-weight: 700;
      color: var(--color-text);
    }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const toggle = document.querySelector('.nav-toggle');
  const menu = document.querySelector<HTMLElement>('#nav-menu');

  if (header) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle('scrolled', !entry.isIntersecting);
      },
      { threshold: 1, rootMargin: '-1px 0px 0px 0px' }
    );

    const sentinel = document.createElement('div');
    sentinel.style.height = '1px';
    sentinel.style.position = 'absolute';
    sentinel.style.top = '0';
    document.body.prepend(sentinel);
    observer.observe(sentinel);
  }

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      toggle.setAttribute('aria-label', expanded ? 'Open menu' : 'Close menu');
      menu.classList.toggle('open');
      header?.classList.toggle('menu-open');
      document.body.style.overflow = expanded ? '' : 'hidden';
    });

    menu.querySelectorAll('.nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
        menu.classList.remove('open');
        header?.classList.remove('menu-open');
        document.body.style.overflow = '';
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('open')) {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
        menu.classList.remove('open');
        header?.classList.remove('menu-open');
        document.body.style.overflow = '';
        (toggle as HTMLElement).focus();
      }
    });
  }
</script>
