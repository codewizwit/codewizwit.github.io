---
import SEO from '../components/global/SEO.astro';
import GrainOverlay from '../components/global/GrainOverlay.astro';
import '../styles/global.css';
import '../styles/typography.css';
import '../styles/utilities.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishDate?: Date;
}

const { title, description, canonical, ogImage, ogType, publishDate } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16.png" />

    <!-- Font Preloads (critical fonts only) -->
    <!-- Fraunces (hero display) + IBM Plex Sans (body sans) from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..900,0..100;1,9..144,300..900,0..100&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Playfair+Display:ital,wght@1,500;1,600;1,700&display=swap" rel="stylesheet" />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      publishDate={publishDate}
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <GrainOverlay />
    <slot />
  </body>
</html>
