              <text class="flow" x="664" y="224">THE LIFT</text>
              <text class="flow-sub" x="664" y="246">
                AI-assisted work that elevates everyone
              </text>

              <!-- ---------- Layer 2: the delivery loop ---------- -->
              <rect class="rule" x="2" y="302" width="26" height="3"></rect>
              <text class="eyb" x="2" y="324">FRAMEWORKS</text>
              <text class="eyb-sub" x="2" y="344">how the work is done</text>

              <!-- prevention closes the loop over the top -->
              <text class="flow" x="396" y="328">
                PREVENTION
                <tspan class="flow-sub" dx="14">
                  every failure becomes a rule, a test, or a doc
                </tspan>
              </text>
              <path class="line-back" d="M 904 364 V 342 H 292 V 352"></path>
              <path class="head" d="M 286 352 L 292 364 L 298 352 Z"></path>

              <g>
                <rect class="box" x="200" y="364" width="184" height="120" rx="2"></rect>
