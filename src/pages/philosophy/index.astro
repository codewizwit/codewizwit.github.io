<style>
  /* ============================================================
     Page frame
     ============================================================ */

  .phil {
    /* The diagram's card fill, and the lime that clears AA on cream at any
       size. Neither exists in global.css yet. Everything else is a token. */
    --phil-card-bg: #faf9f5;
    --phil-lime-text: #5b770d;
  }

  .phil > .section {
    padding-block: var(--space-lg);
  }

  .phil-eyebrow {
    font-family: var(--font-code);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--phil-lime-text);
  }

  /* ============================================================
     The map
     ============================================================ */

  .phil-figure {
    padding-block: var(--space-md);
  }

  /* ============================================================
     Diagram wrapper
     Two variants, wide and narrow, swapped by media query.
     ============================================================ */

  .phil-diagram {
    position: relative;
  }

  .phil-diagram--wide {
    display: none;
    width: 100%;
  }

  .phil-diagram--narrow {
    display: block;
    width: 100%;
    max-width: 27rem;
    margin-inline: auto;
  }

  @media (min-width: 60rem) {
    .phil-diagram--wide {
      display: block;
    }

    .phil-diagram--narrow {
      display: none;
    }
  }

  @keyframes phil-rise {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ============================================================
     Diagram: shared type and shapes
     Lifted from the verified standalone, retokenised to the site.
     ============================================================ */

  .viz text {
    font-family: var(--font-sans);
    fill: var(--color-gray);
  }

  .viz .eyb {
    font-family: var(--font-code);
    font-weight: 500;
    letter-spacing: 0.11em;
    fill: var(--phil-lime-text);
  }

  .viz .stage {
    font-family: var(--font-code);
    font-weight: 500;
    letter-spacing: 0.09em;
    fill: var(--phil-lime-text);
  }

  .viz .tag {
    font-family: var(--font-code);
    font-weight: 500;
    letter-spacing: 0.1em;
    fill: var(--phil-lime-text);
  }

  .viz .num {
