              class="viz viz-wide"
              viewBox="0 0 1000 1064"
              role="img"
              aria-label={diagramAlt}
            >
              <!-- ---------- Layer 1: north star ---------- -->
              <rect class="rule" x="2" y="2" width="26" height="3"></rect>
              <text class="eyb" x="2" y="24">NORTH STAR</text>
              <text class="eyb-sub" x="2" y="44">where it all points</text>

              <path
