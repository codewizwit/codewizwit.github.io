---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

/**
 * The index of the idea corpus. One row per essay in reading order, which
 * follows the philosophy diagram from the north star down to the tooling.
 */

const ideas = (await getCollection('ideas')).sort(
  (a, b) => a.data.order - b.data.order
);

const totalWords = 17603;
---

<PageLayout
  title="Ideas"
  description="Every idea behind the frameworks, written out in full: the north star, the delivery loop, the documentation system underneath, and the tooling that keeps it true."
>
  <article class="ideas">
    <section class="section section-cream" aria-labelledby="ideas-heading">
      <div class="container container-narrow">
        <p class="ideas-eyebrow">Ideas</p>
        <h1 id="ideas-heading" class="ideas-title">
          Everything, written out.
        </h1>
        <p class="ideas-lede">
          Fifteen pieces, roughly {(totalWords / 1000).toFixed(0)},000 words. Each
          one states a single idea: what it means, why it matters now, what it
          looks like in practice, the strongest objection to it, and where it came
          from, with dates.
        </p>

        <ol class="ideas-list">
          {
            ideas.map((idea) => (
              <li class="ideas-item">
                <a class="ideas-link" href={`/ideas/${idea.id}`}>
                  <span class="ideas-num" aria-hidden="true">
                    {String(idea.data.order).padStart(2, '0')}
                  </span>
                  <span class="ideas-body">
                    <span class="ideas-name">{idea.data.title}</span>
                    <span class="ideas-desc">{idea.data.description}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </article>
</PageLayout>

<style>
  .ideas-eyebrow {
    font-family: var(--font-code);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .ideas-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin-top: var(--space-2xs);
  }

  .ideas-lede {
    color: var(--color-text-secondary);
    max-width: 60ch;
    margin-top: var(--space-sm);
  }

  .ideas-list {
    list-style: none;
    margin: var(--space-xl) 0 0;
    padding: 0;
    counter-reset: none;
  }

  .ideas-item + .ideas-item {
    margin-top: 0;
  }

  .ideas-link {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-sm);
    align-items: baseline;
    padding-block: var(--space-sm);
    border-top: 1px solid var(--color-gray-border);
    text-decoration: none;
    color: inherit;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .ideas-item:last-child .ideas-link {
    border-bottom: 1px solid var(--color-gray-border);
  }

  .ideas-link:hover,
  .ideas-link:focus-visible {
    background-color: rgba(31, 77, 216, 0.04);
  }

  .ideas-num {
    font-family: var(--font-code);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-cobalt-dark);
  }

  .ideas-body {
    display: block;
  }

  .ideas-name {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .ideas-link:hover .ideas-name {
    color: var(--color-cobalt-dark);
  }

  .ideas-desc {
    display: block;
    color: var(--color-text-secondary);
    max-width: 62ch;
    margin-top: var(--space-3xs, 0.25rem);
  }

  @media (max-width: 34rem) {
    .ideas-link {
      grid-template-columns: 2.25rem 1fr;
      gap: var(--space-xs);
    }
  }
</style>
