---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

/**
 * One essay per entry, rendered straight from the markdown. Prev and next
 * follow the same reading order as the index, so the corpus reads as a
 * sequence rather than a pile.
 */

export const getStaticPaths = (async () => {
  const ideas = (await getCollection('ideas')).sort(
    (a, b) => a.data.order - b.data.order
  );
  return ideas.map((idea, index) => ({
    params: { id: idea.id },
    props: {
      idea,
      prev: index > 0 ? ideas[index - 1] : null,
      next: index < ideas.length - 1 ? ideas[index + 1] : null,
      total: ideas.length,
    },
  }));
}) satisfies GetStaticPaths;

const { idea, prev, next, total } = Astro.props;
const { Content } = await render(idea);
---

<PageLayout title={idea.data.title} description={idea.data.description}>
  <article class="idea">
    <section class="section section-cream" aria-labelledby="idea-heading">
      <div class="container container-narrow">
        <p class="idea-eyebrow">
          <a href="/ideas">Ideas</a>
          <span aria-hidden="true"> / </span>
          <span>{String(idea.data.order).padStart(2, '0')} of {total}</span>
        </p>

        <h1 id="idea-heading" class="idea-title">{idea.data.title}</h1>
        <p class="idea-lede">{idea.data.description}</p>

        <div class="idea-body">
          <Content />
        </div>

        <nav class="idea-nav" aria-label="More ideas">
          {
            prev ? (
              <a class="idea-nav__link" href={`/ideas/${prev.id}`}>
                <span class="idea-nav__dir" aria-hidden="true">
                  &#8592;
                </span>
                <span class="idea-nav__name">{prev.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a class="idea-nav__link idea-nav__link--next" href={`/ideas/${next.id}`}>
                <span class="idea-nav__name">{next.data.title}</span>
                <span class="idea-nav__dir" aria-hidden="true">
                  &#8594;
                </span>
              </a>
            )
          }
        </nav>
      </div>
    </section>
  </article>
</PageLayout>

<style>
  .idea-eyebrow {
    font-family: var(--font-code);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .idea-eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .idea-eyebrow a:hover {
    color: var(--color-cobalt-dark);
  }

  .idea-title {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin-top: var(--space-2xs);
  }

  .idea-lede {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.4;
    max-width: 52ch;
    margin-top: var(--space-sm);
  }

  /* ---- The rendered markdown ------------------------------------------
     Deliberately plain. The corpus carries its own structure in headings,
     tables, and lists, so this only sets rhythm and measure.
     -------------------------------------------------------------------- */

  .idea-body {
    margin-top: var(--space-lg);
    max-width: 68ch;
  }

  .idea-body :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-top: var(--space-lg);
  }

  .idea-body :global(h3) {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    margin-top: var(--space-md);
  }

  .idea-body :global(p),
  .idea-body :global(li) {
    color: var(--color-text-secondary);
  }

  .idea-body :global(p),
  .idea-body :global(ul),
  .idea-body :global(ol) {
    margin-top: var(--space-sm);
  }

  .idea-body :global(ul),
  .idea-body :global(ol) {
    padding-left: 1.2em;
  }

  .idea-body :global(li + li) {
    margin-top: 0.35em;
  }

  .idea-body :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .idea-body :global(a) {
    color: var(--color-cobalt-dark);
    text-underline-offset: 0.2em;
  }

  .idea-body :global(blockquote) {
    border-left: 2px solid var(--color-cobalt);
    padding-left: var(--space-sm);
    margin-top: var(--space-sm);
    font-style: italic;
  }

  .idea-body :global(code) {
    font-family: var(--font-code);
    font-size: 0.9em;
  }

  /* Provenance tables are wide by nature; they scroll rather than the page. */
  .idea-body :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
  }

  .idea-body :global(th),
  .idea-body :global(td) {
    border-bottom: 1px solid var(--color-gray-border);
    padding: var(--space-2xs) var(--space-xs);
    text-align: left;
    vertical-align: top;
    color: var(--color-text-secondary);
  }

  .idea-body :global(th) {
    font-family: var(--font-code);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text);
    white-space: nowrap;
  }

  .idea-body :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-gray-border);
    margin-block: var(--space-lg);
  }

  .idea-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-gray-border);
  }

  .idea-nav__link {
    display: flex;
    gap: var(--space-2xs);
    align-items: baseline;
    text-decoration: none;
    color: var(--color-text-secondary);
    max-width: 22ch;
  }

  .idea-nav__link--next {
    text-align: right;
    margin-left: auto;
  }

  .idea-nav__link:hover {
    color: var(--color-cobalt-dark);
  }

  .idea-nav__dir {
    color: var(--color-cobalt-dark);
  }

  .idea-nav__name {
    font-family: var(--font-display);
    font-weight: 600;
  }
</style>
